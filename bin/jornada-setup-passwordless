#!/bin/sh
#
# jornada-setup-passwordless — one-time setup so "Connect" never needs a
# password again. Run ONCE with sudo (this is the single authenticated step):
#
#     sudo ./bin/jornada-setup-passwordless
#     sudo ./bin/jornada-setup-passwordless --uninstall
#
# It installs two argument-free, root-owned helper scripts and a NOPASSWD
# sudoers rule scoped to EXACTLY those two commands — nothing else gains
# passwordless root. See SECURITY.md for the trade-off.
set -eu

LIBEXEC=/usr/local/libexec/jornada-link
ETCDIR=/usr/local/etc/jornada-link
RUNDIR=/usr/local/var/run/jornada-link
SUDOERS=/etc/sudoers.d/jornada-link
CONNECT="$LIBEXEC/jornada-connect"
DISCONNECT="$LIBEXEC/jornada-disconnect"

if [ "$(id -u)" -ne 0 ]; then
  echo "This must run as root:  sudo $0 $*" >&2
  exit 1
fi

TARGET_USER="${SUDO_USER:-}"
if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
  echo "Refusing to install for root; run it with 'sudo' as your normal user." >&2
  exit 1
fi
case "$TARGET_USER" in
  *[!A-Za-z0-9._-]*) echo "Refusing suspicious user name '$TARGET_USER'." >&2; exit 1;;
esac

uninstall() {
  echo "Removing passwordless connect for '$TARGET_USER'..."
  rm -f "$SUDOERS"
  rm -f "$CONNECT" "$DISCONNECT"
  rmdir "$LIBEXEC" 2>/dev/null || true
  rm -f "$ETCDIR/config"
  rmdir "$ETCDIR" 2>/dev/null || true
  rm -rf "$RUNDIR"
  echo "Done. 'Connect' will prompt for your password again."
}

if [ "${1:-}" = "--uninstall" ]; then
  uninstall
  exit 0
fi

# Locate the helper sources next to this script (the reviewable repo copies).
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
SRC_CONNECT="$SCRIPT_DIR/jornada-connect"
SRC_DISCONNECT="$SCRIPT_DIR/jornada-disconnect"
for f in "$SRC_CONNECT" "$SRC_DISCONNECT"; do
  [ -r "$f" ] || { echo "Cannot find helper source: $f" >&2; exit 1; }
  sh -n "$f" || { echo "Helper failed syntax check: $f" >&2; exit 1; }
done

# --- install the root-owned helpers ----------------------------------------
install -d -o root -g wheel -m 0755 "$LIBEXEC" "$ETCDIR" "$RUNDIR"
install -o root -g wheel -m 0755 "$SRC_CONNECT" "$CONNECT"
install -o root -g wheel -m 0755 "$SRC_DISCONNECT" "$DISCONNECT"

# --- root-owned config: pin the device/baud from the user's working setup ---
USER_HOME=$(dscl . -read "/Users/$TARGET_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
USER_HOME="${USER_HOME:-/Users/$TARGET_USER}"
DEVICE=""
BAUD=115200
pin="$USER_HOME/.jornada-link/serial"
if [ -r "$pin" ]; then
  d=$(head -n1 "$pin" | tr -d '[:space:]')
  case "$d" in
    /dev/cu.*) case "$d" in *[!/A-Za-z0-9._-]*) ;; *) DEVICE="$d";; esac ;;
  esac
fi
bpin="$USER_HOME/.jornada-link/baud"
if [ -r "$bpin" ]; then
  b=$(head -n1 "$bpin" | tr -d '[:space:]')
  case "$b" in 9600|19200|38400|57600|115200) BAUD="$b";; esac
fi
umask 022
{
  echo "# jornada-link connect config (root-owned). Edit DEVICE/BAUD as needed."
  echo "# DEVICE empty = auto-detect the first /dev/cu.usbserial-*"
  echo "DEVICE=$DEVICE"
  echo "BAUD=$BAUD"
} > "$ETCDIR/config"
chown root:wheel "$ETCDIR/config"
chmod 0644 "$ETCDIR/config"

# --- sudoers rule, validated before it goes live ---------------------------
tmp=$(mktemp /tmp/jornada-sudoers.XXXXXX)
{
  echo "# Installed by jornada-setup-passwordless. Passwordless connect/disconnect only."
  echo "$TARGET_USER ALL=(root) NOPASSWD: $CONNECT"
  echo "$TARGET_USER ALL=(root) NOPASSWD: $DISCONNECT"
} > "$tmp"
if ! visudo -cf "$tmp" >/dev/null 2>&1; then
  echo "Generated sudoers file failed validation; aborting (no changes to /etc/sudoers.d)." >&2
  rm -f "$tmp"
  exit 1
fi
install -o root -g wheel -m 0440 "$tmp" "$SUDOERS"
rm -f "$tmp"

# We are already root here: clear any engine left over from the admin-prompt
# path (a legacy runner loop would otherwise fight the new helper for the port).
"$DISCONNECT" >/dev/null 2>&1 || true

echo ""
echo "Passwordless connect installed for '$TARGET_USER'."
echo "  helpers : $CONNECT"
echo "            $DISCONNECT"
echo "  config  : $ETCDIR/config  (DEVICE=${DEVICE:-auto} BAUD=$BAUD)"
echo "  sudoers : $SUDOERS  (NOPASSWD, scoped to those two commands only)"
echo ""
echo "Click Connect in Jornada Sync.app (no more prompt), or run:  ./bin/jornada-ppp"
echo "To undo:  sudo $0 --uninstall"
